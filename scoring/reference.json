{
  "experiments": {
    "college_admission_core": {
      "description": "Synthetic College Admission CGPR team decision task at p=0.5, delta=0.25, alpha=0.9. Reference values are from the authors' released College Admission imperfect-human synthetic output for this setting.",
      "weight": 1.0,
      "primary_metric": "team_accuracy",
      "metrics": {
        "team_accuracy": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "reliance_probability": {
          "higher_is_better": true,
          "coefficient": 0.4
        },
        "routing_accuracy": {
          "higher_is_better": true,
          "coefficient": 0.2
        }
      },
      "results": {
        "behavior_aware_ai": {
          "type": "baseline",
          "team_accuracy": 0.766,
          "reliance_probability": 0.7467616580310881
        },
        "aligned_ai": {
          "type": "baseline",
          "team_accuracy": 0.73,
          "reliance_probability": 0.8795336787564767
        },
        "complementary_ai": {
          "type": "baseline",
          "team_accuracy": 0.7783333333333333
        },
        "adaptive_oracle": {
          "type": "proposed",
          "team_accuracy": 0.806,
          "reliance_probability": 0.8795336787564767,
          "routing_accuracy": 1.0
        },
        "adaptive_weighted_oracle": {
          "type": "proposed",
          "team_accuracy": 0.7946666666666666,
          "reliance_probability": 0.8737046632124352,
          "routing_accuracy": 1.0
        }
      }
    }
  }
